{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Habit Pulse Export",
  "type": "object",
  "required": ["version", "exportedAt", "habits"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "exportedAt": {"type": "string", "format": "date-time"},
    "habits": {"type": "array", "items": {"type": "object", "required": ["id", "name", "history"]}}
  }
}
